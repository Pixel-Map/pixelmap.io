FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download github.com/joho/godotenv github.com/lib/pq github.com/golang-module/dongle go.uber.org/zap go.uber.org/multierr golang.org/x/image
COPY internal/utils ./internal/utils
COPY internal/notifications ./internal/notifications
COPY cmd/discord-bot ./cmd/discord-bot
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/discord-bot ./cmd/discord-bot

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/discord-bot /app/discord-bot
USER 65534:65534
ENTRYPOINT ["/app/discord-bot"]
